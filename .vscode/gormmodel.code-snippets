            "// OPTIMIZE: ${3:Descrição da otimização}",
            "// SECURITY: ${4:Descrição da melhoria de segurança}"
        ],
        "description": "Insere um bloco de TODOs"
    },

    // ============================================================
    // CONSTANTES
    // ============================================================
    "Bloco de Constantes": {
        "prefix": "gormconst",
        "body": [
            "// ============================================================",
            "// CONSTANTES",
            "// ============================================================",
            "",
            "const (",
            "    ${1:Constante1} = ${2:1}",
            "    ${3:Constante2} = ${4:2}",
            ")"
        ],
        "description": "Insere um bloco de constantes"
    }
}
{
    // ============================================================
    // MODEL COMPLETO
    // ============================================================
    "GORM Model Completo": {
        "prefix": "gormmodel",
        "body": [
            "package models",
            "",
            "import (",
            "    \"time\"",
            ")",
            "",
            "type $1 struct {",
            "    // ============================================================",
            "    // CAMPOS PRINCIPAIS",
            "    // ============================================================",
            "    ID        int    `gorm:\"column:${2:id};primaryKey;autoIncrement\" json:\"id\"`",
            "    ${3:Field} ${4:string} `gorm:\"column:${5:column_name};type:${6:varchar(255)};not null\" json:\"${7:json_name}\"`",
            "",
            "    // ============================================================",
            "    // CAMPOS DE AUDITORIA",
            "    // ============================================================",
            "    CreatedAt time.Time  `gorm:\"column:created_at;type:datetime;default:CURRENT_TIMESTAMP\" json:\"created_at\"`",
            "    UpdatedAt time.Time  `gorm:\"column:updated_at;type:datetime;default:CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP\" json:\"updated_at\"`",
            "    DeletedAt *time.Time `gorm:\"column:deleted_at;type:datetime;index\" json:\"deleted_at,omitempty\"`",
            "    CreatedBy *int       `gorm:\"column:created_by\" json:\"created_by,omitempty\"`",
            "    UpdatedBy *int       `gorm:\"column:updated_by\" json:\"updated_by,omitempty\"`",
            "}",
            "",
            "// ============================================================",
            "// MÉTODOS DO MODEL",
            "// ============================================================",
            "",
            "func ($1) TableName() string {",
            "    return \"${8:tabela}\"",
            "}",
            "",
            "func (m *$1) BeforeCreate() error {",
            "    if m.CreatedBy == nil {",
            "        m.CreatedBy = new(int)",
            "        *m.CreatedBy = 0",
            "    }",
            "    if m.UpdatedBy == nil {",
            "        m.UpdatedBy = new(int)",
            "        *m.UpdatedBy = 0",
            "    }",
            "    return nil",
            "}",
            "",
            "func (m *$1) BeforeUpdate() error {",
            "    if m.UpdatedBy == nil {",
            "        m.UpdatedBy = new(int)",
            "        *m.UpdatedBy = 0",
            "    }",
            "    return nil",
            "}",
            "",
            "// ============================================================",
            "// MÉTODOS AUXILIARES",
            "// ============================================================",
            "",
            "func (m *$1) IsActive() bool {",
            "    // TODO: Implementar lógica de ativo",
            "    return true",
            "}",
            "",
            "func (m *$1) IsDeleted() bool {",
            "    return m.DeletedAt != nil",
            "}",
            "",
            "func (m *$1) SoftDelete() {",
            "    now := time.Now()",
            "    m.DeletedAt = &now",
            "}"
        ],
        "description": "Cria um model GORM completo com campos de auditoria"
    },

    // ============================================================
    // MODEL SIMPLES (SEM AUDITORIA)
    // ============================================================
    "GORM Model Simples": {
        "prefix": "gormsimple",
        "body": [
            "package models",
            "",
            "type $1 struct {",
            "    ID int `gorm:\"column:${2:id};primaryKey;autoIncrement\" json:\"id\"`",
            "    $3 $4 `gorm:\"column:${5:column_name};type:${6:varchar(255)}\" json:\"${7:json_name}\"`",
            "}",
            "",
            "func ($1) TableName() string {",
            "    return \"${8:tabela}\"",
            "}"
        ],
        "description": "Cria um model GORM simples"
    },

    // ============================================================
    // CAMPO COM TAG GORM
    // ============================================================
    "Campo GORM": {
        "prefix": "gormfield",
        "body": [
            "${1:FieldName} ${2:string} `gorm:\"column:${3:column_name};type:${4:varchar(255)};${5:not null}\" json:\"${6:json_name},omitempty\"`"
        ],
        "description": "Insere um campo com tags GORM"
    },

    // ============================================================
    // CAMPO PONTEIRO (NULLABLE)
    // ============================================================
    "Campo GORM Nullable": {
        "prefix": "gormnull",
        "body": [
            "${1:FieldName} *${2:string} `gorm:\"column:${3:column_name};type:${4:varchar(255)}\" json:\"${5:json_name},omitempty\"`"
        ],
        "description": "Insere um campo NULLABLE com tags GORM"
    },

    // ============================================================
    // CAMPOS DE AUDITORIA
    // ============================================================
    "Campos de Auditoria": {
        "prefix": "gormaudit",
        "body": [
            "// ============================================================",
            "// CAMPOS DE AUDITORIA",
            "// ============================================================",
            "CreatedAt time.Time  `gorm:\"column:created_at;type:datetime;default:CURRENT_TIMESTAMP\" json:\"created_at\"`",
            "UpdatedAt time.Time  `gorm:\"column:updated_at;type:datetime;default:CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP\" json:\"updated_at\"`",
            "DeletedAt *time.Time `gorm:\"column:deleted_at;type:datetime;index\" json:\"deleted_at,omitempty\"`",
            "CreatedBy *int       `gorm:\"column:created_by\" json:\"created_by,omitempty\"`",
            "UpdatedBy *int       `gorm:\"column:updated_by\" json:\"updated_by,omitempty\"`"
        ],
        "description": "Insere os campos de auditoria do GORM"
    },

    // ============================================================
    // MÉTODOS AUXILIARES
    // ============================================================
    "Métodos Auxiliares": {
        "prefix": "gormmethods",
        "body": [
            "// ============================================================",
            "// MÉTODOS AUXILIARES",
            "// ============================================================",
            "",
            "func (m *$1) IsActive() bool {",
            "    // TODO: Implementar lógica de ativo",
            "    return m.Situacao == 1",
            "}",
            "",
            "func (m *$1) IsDeleted() bool {",
            "    return m.DeletedAt != nil",
            "}",
            "",
            "func (m *$1) SoftDelete() {",
            "    now := time.Now()",
            "    m.DeletedAt = &now",
            "}"
        ],
        "description": "Insere métodos auxiliares para o model"
    },

    // ============================================================
    // RELACIONAMENTO BELONGS TO
    // ============================================================
    "Relacionamento Belongs To": {
        "prefix": "gormbelongs",
        "body": [
            "// ============================================================",
            "// RELACIONAMENTOS",
            "// ============================================================",
            "${1:NomeRelacionamento} *${2:Model} `gorm:\"foreignKey:${3:ForeignKey};references:${4:ReferencedKey}\" json:\"${5:json_name},omitempty\"`"
        ],
        "description": "Insere um relacionamento Belongs To"
    },

    // ============================================================
    // RELACIONAMENTO HAS MANY
    // ============================================================
    "Relacionamento Has Many": {
        "prefix": "gormhasmany",
        "body": [
            "${1:Relacionamentos} []${2:Model} `gorm:\"foreignKey:${3:ForeignKey};references:${4:ReferencedKey}\" json:\"${5:json_name},omitempty\"`"
        ],
        "description": "Insere um relacionamento Has Many"
    },

    // ============================================================
    // TODO BLOCK
    // ============================================================
    "TODO Block": {
        "prefix": "todo",
        "body": [
            "// TODO: ${1:Descrição do que precisa ser feito}",
